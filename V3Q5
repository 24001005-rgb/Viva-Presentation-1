package com.guild.schedule.MagicCourse;

import java.util.List;

public class MagicCourse {

    private String courseName;
    private String dayOfWeek;
    private Integer startTime;
    private Integer endTime;

    private static final int MAX_HOUR = 24;
    private static int totalCourses = 0;

    // No-argument constructor
    public MagicCourse() {
        this.courseName = "Unnamed Magic Course";
        this.dayOfWeek = "Not Set";
        this.startTime = null;
        this.endTime = null;
        totalCourses++;
    }

    // Parameterized constructor
    public MagicCourse(String courseName, String dayOfWeek, int startTime, int endTime) {
        if (courseName == null || courseName.trim().isEmpty()) {
            throw new IllegalArgumentException("Course name cannot be empty");
        }
        if (startTime < 0 || endTime < 0 || startTime > MAX_HOUR || endTime > MAX_HOUR) {
            throw new IllegalArgumentException("Time out of valid range");
        }
        if (startTime >= endTime) {
            throw new IllegalArgumentException("Course end time must be later than start time");
        }

        this.courseName = courseName;
        this.dayOfWeek = dayOfWeek;
        this.startTime = startTime;
        this.endTime = endTime;
        totalCourses++;
    }

    // Getters and Setters
    public String getCourseName() {
        return courseName;
    }

    public void setCourseName(String courseName) {
        if (courseName == null || courseName.trim().isEmpty()) {
            throw new IllegalArgumentException("Course name cannot be empty");
        }
        this.courseName = courseName;
    }

    public String getDayOfWeek() {
        return dayOfWeek;
    }

    public void setDayOfWeek(String dayOfWeek) {
        if (dayOfWeek == null || dayOfWeek.trim().isEmpty()) {
            throw new IllegalArgumentException("Day of week cannot be empty");
        }
        this.dayOfWeek = dayOfWeek;
    }

    public int getStartTime() {
        return startTime;
    }

    public void setStartTime(int startTime) {
        if (startTime < 0 || startTime > MAX_HOUR) {
            throw new IllegalArgumentException("Time out of valid range");
        }
        if (this.endTime != null && startTime >= this.endTime) {
            throw new IllegalArgumentException("Start time must be earlier than end time");
        }
        this.startTime = startTime;
    }

    public int getEndTime() {
        return endTime;
    }

    public void setEndTime(int endTime) {
        if (endTime < 0 || endTime > MAX_HOUR) {
            throw new IllegalArgumentException("Time out of valid range");
        }
        if (this.startTime != null && endTime <= this.startTime) {
            throw new IllegalArgumentException("End time must be later than start time");
        }
        this.endTime = endTime;
    }

    // Static methods
    public static int getTotalCourses() {
        return totalCourses;
    }

    public static boolean hasConflict(MagicCourse c1, MagicCourse c2) {
        if (c1.startTime == null || c1.endTime == null ||
            c2.startTime == null || c2.endTime == null) {
            throw new IllegalStateException("Course time is not set");
        }

        if (!c1.dayOfWeek.equalsIgnoreCase(c2.dayOfWeek)) {
            return false;
        }

        return c1.startTime < c2.endTime && c2.startTime < c1.endTime;
    }

    public static Integer countConflicts(List<MagicCourse> courseList) {
        if (courseList == null || courseList.isEmpty()) {
            return null;
        }

        int count = 0;
        for (int i = 0; i < courseList.size(); i++) {
            for (int j = i + 1; j < courseList.size(); j++) {
                if (hasConflict(courseList.get(i), courseList.get(j))) {
                    count++;
                }
            }
        }
        return count;
    }
}
